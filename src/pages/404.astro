---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" cierre={false}>
  <section class="cab">
    <p class="label">Error 404</p>
    <h1 class="disp">Aquí no hay nada</h1>
  </section>
  <section class="vacio">
    <p>La página que buscas no existe o ha cambiado de sitio.</p>
    <a class="mas" href="/">Volver al inicio</a>
  </section>
</Base>
