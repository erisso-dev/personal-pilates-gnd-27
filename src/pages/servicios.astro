---
import Base from '../layouts/Base.astro';
import Testimonios from '../components/Testimonios.astro';
import faq from '../data/faq.json';

const salas = [
  { n: 'Sala Torres', d: 'Clases con la torre de muelles, que te asiste y te desafía en cada ejercicio.' },
  { n: 'Sala Reformers', d: 'Clases sobre el reformer, la máquina de carro deslizante y muelles del método Pilates.' },
];
---
<Base title="Servicios" description="Pilates con aparatos en Gandía: clases en dos salas, Torres y Reformers, siempre en grupos de 6.">
  <section class="cab">
    <p class="label">Servicios</p>
    <h1 class="disp">Entrenamiento para tu calidad de vida</h1>
    <p class="intro">En Personal Pilates te damos tu «dosis» de movimiento.</p>
  </section>

  <section class="dos">
    <h2 class="disp rv">¿Te suena?</h2>
    <ul class="lista rv">
      <li>Quieres moverte para no sentirte tan entumecido.</li>
      <li>Buscas aumentar tus niveles de actividad física.</li>
      <li>No puedes acudir a un centro donde los grupos son numerosos y no atienden tus necesidades personales.</li>
      <li>Buscas trabajar tu flexibilidad y aumentar tu tono muscular.</li>
      <li>Buscas una mejor forma física para afrontar tu día a día.</li>
      <li>Buscas un complemento a tu deporte para organizar mejor tu sistema muscular.</li>
    </ul>
  </section>

  <figure class="banda"><img src="/assets/torre-luz.webp" alt="Estudio de Pilates con reformer y torre de muelles a la luz de la mañana" loading="lazy"></figure>

  <section class="prog" id="programas">
    <div class="prog-head">
      <h2 class="disp rv">Dos salas, grupos de 6</h2>
      <p class="rv">Programamos tus clases en un horario fijo y con un grupo lo más homogéneo posible. Buscamos el horario que mejor se te acople, porque sin una asistencia regular es imposible disfrutar de los beneficios del Pilates.</p>
    </div>
    {salas.map((f) => (
      <article class="row rv">
        <h3>{f.n}</h3>
        <p>{f.d}</p>
        <div class="dots">
          {Array.from({ length: 6 }).map(() => <i />)}<i class="p" />
          <span>Grupos de 6</span>
        </div>
      </article>
    ))}
  </section>

  <section class="dos dark">
    <h2 class="disp rv">Lo que vas a notar</h2>
    <div class="prosa rv">
      <ul class="lista">
        <li>Necesitarás menos esfuerzo para moverte mejor.</li>
        <li>Despertarás los músculos que te proporcionan una mejor postura.</li>
        <li>Activarás el motor de tu cuerpo y tendrás más energía.</li>
      </ul>
      <h3>Si el Pilates va a ser tu única actividad física</h3>
      <ul class="lista">
        <li>Aprenderás a controlar mejor tu cuerpo e identificarás las tensiones negativas.</li>
        <li>Mejorarás tu capacidad respiratoria.</li>
        <li>Flexibilizarás la musculatura acortada.</li>
        <li>Fortalecerás la musculatura profunda, muy importante para una mejor actitud postural.</li>
      </ul>
      <h3>Si lo quieres como complemento a tu deporte</h3>
      <ul class="lista">
        <li>Entenderás qué tensiones debes evitar, al coordinar y disociar mejor unos movimientos de otros.</li>
        <li>Ganarás estabilidad en las articulaciones, fruto del trabajo de la musculatura profunda.</li>
        <li>Ganarás rango de movimiento, vital para evitar lesiones.</li>
      </ul>
    </div>
  </section>

  <Testimonios />

  <section class="faq">
    <h2 class="disp rv">Preguntas frecuentes</h2>
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div>{f.a.map((p) => <p>{p}</p>)}</div>
      </details>
    ))}
  </section>
</Base>
